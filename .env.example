# Direct LLM provider: deepseek or openai. Both use Chat Completions.
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1

# Direct AscendC multi-turn generator request settings.
ASCENDC_LLM_TEMPERATURE=0.2
# Legacy blanket override. Leave unset to use the per-call budgets below.
# ASCENDC_LLM_MAX_TOKENS=
ASCENDC_ROUTER_MAX_TOKENS=4096
ASCENDC_GENERATOR_MAX_TOKENS=65536
ASCENDC_REPAIR_MAX_TOKENS=65536
ASCENDC_ROUTER_THINKING=disabled
ASCENDC_GENERATOR_THINKING=enabled
ASCENDC_REPAIR_THINKING=enabled
ASCENDC_GENERATOR_REASONING_EFFORT=high
ASCENDC_REPAIR_REASONING_EFFORT=max
ASCENDC_LLM_TRANSIENT_RETRIES=3
ASCENDC_LLM_TIMEOUT=600
ASCENDC_KNOWLEDGE_MAX_API_DOCS=8
ASCENDC_KNOWLEDGE_MAX_CHARS=24000

# Claude Code runtime used by the Triton, interactive AscendC, and
# AutoResearch workflows. Authentication is consumed by the external
# `claude` CLI, not by the Python OpenAI-compatible client.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=

# Per-Agent model overrides. Blank values fall back to CLAUDE_MODEL or to the
# Claude CLI's configured default model.
TRITON_AGENT_MODEL=
ASCENDC_AGENT_MODEL=
AUTORESEARCH_MODEL=

# Optional Claude CLI request timeout used by compatible gateways.
API_TIMEOUT_MS=300000
